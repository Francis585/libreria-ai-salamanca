# Copia este archivo a .env.local para desarrollo.
# En Vercel estas variables se configuran en Project → Settings → Environment Variables
# (DATABASE_URL / DATABASE_URL_UNPOOLED las inyecta la integración de Neon).

# Postgres de Neon (cadena pooled, la que usa la función serverless)
DATABASE_URL=postgres://usuario:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cadena directa, solo para migraciones (node scripts/migrate.mjs)
DATABASE_URL_UNPOOLED=postgres://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Token del panel /admin y de /api/admin-resumen. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=

# Opcional: activa el oráculo con Gemini. Sin ella usa el motor semántico local.
GEMINI_API_KEY=
